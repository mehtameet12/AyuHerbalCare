{
  "name": "ayuherbalcare",
  "version": "1.0.0",
  "private": true,
  "description": "Single-page marketing site for AyuHerbalCare — Ayurvedic healing & herbal therapy.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run lint:css && npm run build && npm run test:ui",
    "test:ui": "node scripts/check-responsive.mjs"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "iOS >= 15",
    "Safari >= 15",
    "not dead"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axe-core": "^4.12.1",
    "browserslist": "^4.28.0",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "lightningcss": "^1.30.2",
    "prettier": "^3.6.2",
    "puppeteer-core": "^24.29.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^7.2.2"
  }
}
